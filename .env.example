# Copy to apps/web/.env.local and fill in. Never commit real keys.

# ---- Public (shipped to the browser) ----
NEXT_PUBLIC_NETWORK_ID=testnet
NEXT_PUBLIC_CONTRACT_ID=sentinel-vault-yourname.testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io

# ---- Server only (Attack Lab on-chain mode) ----
# The demo agent's account and a FUNCTION-CALL key limited to `request_transfer` on the vault.
# Generate it with: node scripts/agent-key.mjs
AGENT_ACCOUNT_ID=sentinel-agent-yourname.testnet
AGENT_PRIVATE_KEY=ed25519:...

# ---- Optional: LLM-driven agent proposals (never used for authorization) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
